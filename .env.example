# MOMENT Platform Environment Configuration Template
# ===================================================
# Copy this file to .env and fill in your actual credentials

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
SQLITE_DB_PATH=backend/app/data/moment.db

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here

# Groq Cloud API (High-Speed Indic Clinical Explanations)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA Nemotron LLM API (Clinical Pathophysiology & Postpartum Anemia Diet Plan)
NVIDIA_NEMOTRON_API_KEY=nvapi-your_nvidia_api_key_here
NEMOTRON_API_KEY=nvapi-your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google Cloud Translation API (Optional fallback for 22+ Indic Languages)
GOOGLE_TRANSLATE_API_KEY=AIzaSy_your_key_here

# Twilio Emergency Alerting (Live Obstetric Red Alert SMS & WhatsApp)
NOTIFICATION_MODE=production
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
DEFAULT_EMERGENCY_WHATSAPP=whatsapp:+919876543210
TWILIO_CONTENT_SID=

# Geospatial & OpenStreetMap
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_SECONDS=4
